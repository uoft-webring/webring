# Copy to .env and fill in. Values below point at the LOCAL Supabase stack (`supabase start`),
# which this repo runs on ports 546xx so it can sit next to other local Supabase projects.

# `supabase status` prints these; the keys below are Supabase's public local-dev defaults
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54621"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

NEXT_PUBLIC_HOME_DOMAIN=http://localhost:3000

# Any random string locally; production's value must never change (it derives members' TXT records)
DOMAIN_VALIDATION_SECRET_KEY=local-dev-secret
# Shared with the Supabase webhook that calls /api/revalidate (optional locally)
REVALIDATION_SECRET_TOKEN=
# Shared with the GitHub Actions that call /api/cron/* (any random string locally)
CRON_SECRET=
# Comma-separated member emails who can open /admin/ring, the ring review queue
ADMIN_EMAILS=

# Avatar storage (ask a maintainer)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
NEXT_PUBLIC_AWS_CLOUDFRONT_DOMAIN=

# Leave the key empty locally so development never sends events to production analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
